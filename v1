<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dynamic Vitality Planner</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .modal-overlay { background: rgba(0, 0, 0, 0.7); }
        .recipe-cell:hover { background-color: #f0f4ff; cursor: pointer; }
        @media (max-width: 400px) {
            h1 { font-size: 1.5rem !important; }
            .recipe-cell { padding: 0.5rem !important; font-size: 0.75rem; }
        }
        
        /* Success animation for the button */
        @keyframes bounce-subtle {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-3px); }
        }
        .btn-success-animate {
            animation: bounce-subtle 3s infinite;
        }

        .star-rating {
            display: inline-flex;
            flex-direction: row-reverse;
        }
        .star-rating input { display: none; }
        .star-rating label {
            font-size: 1.5rem;
            color: #cbd5e1;
            cursor: pointer;
            transition: color 0.2s;
        }
        .star-rating label:hover,
        .star-rating label:hover ~ label,
        .star-rating input:checked ~ label {
            color: #fbbf24;
        }
    </style>
</head>
<body class="bg-slate-50 min-h-screen pb-20">

    <div class="max-w-6xl mx-auto px-2 py-4 sm:px-4 sm:py-8">
        <header class="text-center mb-6">
            <h1 class="text-2xl sm:text-4xl font-bold text-slate-800">Vitality Planner</h1>
            
            <!-- Navigation & Celebration Container -->
            <div class="mt-6 flex flex-wrap justify-center items-center gap-2">
                <button onclick="setView('grid')" id="btn-grid" class="px-4 py-2 rounded-full bg-indigo-600 text-white font-bold text-sm shadow">Meal Plan</button>
                <button onclick="setView('editor')" id="btn-editor" class="px-4 py-2 rounded-full bg-white text-slate-600 font-bold text-sm shadow border border-slate-200">Recipe Editor</button>
                
                <button onclick="celebrateSuccess()" class="btn-success-animate bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-full font-bold shadow border border-green-400 text-sm transform transition active:scale-95 flex items-center gap-1">
                    <span>🎉</span> We made it!
                </button>
            </div>
        </header>

        <!-- Celebration / Success Section (Hidden by default) -->
        <div id="success-section" class="hidden max-w-2xl mx-auto mb-8 bg-gradient-to-br from-green-50 to-emerald-50 p-6 rounded-2xl border-2 border-green-200 shadow-xl">
            <div class="flex justify-between items-start mb-4">
                <h2 class="text-2xl font-bold text-green-800">Milestone: We Made It! 🚀</h2>
                <button onclick="hideSuccess()" class="text-green-600 hover:text-green-800 font-bold">&times;</button>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Left: Notes & Rating -->
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-semibold text-green-700 mb-1">How do you feel?</label>
                        <div class="star-rating">
                            <input type="radio" id="star5" name="rating" value="5"><label for="star5">★</label>
                            <input type="radio" id="star4" name="rating" value="4"><label for="star4">★</label>
                            <input type="radio" id="star3" name="rating" value="3"><label for="star3">★</label>
                            <input type="radio" id="star2" name="rating" value="2"><label for="star2">★</label>
                            <input type="radio" id="star1" name="rating" value="1"><label for="star1">★</label>
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-green-700 mb-1">Success Notes</label>
                        <textarea id="success-notes" rows="3" placeholder="What worked well this week?" class="w-full p-3 border border-green-200 rounded-xl focus:ring-2 focus:ring-green-500 outline-none text-sm"></textarea>
                    </div>
                </div>

                <!-- Right: Photos -->
                <div>
                    <label class="block text-sm font-semibold text-green-700 mb-1">Add Photos (Meals/Results)</label>
                    <div class="flex flex-col gap-2">
                        <input type="file" id="photo-upload" accept="image/*" multiple class="text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-green-100 file:text-green-700 hover:file:bg-green-200">
                        <div id="photo-preview-grid" class="grid grid-cols-3 gap-2 mt-2">
                            <!-- Previews appear here -->
                        </div>
                    </div>
                </div>
            </div>
            
            <button onclick="saveSuccessLog()" class="mt-6 w-full bg-green-600 text-white font-bold py-2 rounded-xl hover:bg-green-700 shadow-lg">Save Milestone Log</button>
        </div>

        <!-- View 1: Meal Plan Grid -->
        <div id="grid-view">
            <div class="overflow-x-auto bg-white rounded-xl shadow-md mb-8">
                <table class="w-full text-left border-collapse text-sm">
                    <thead>
                        <tr class="bg-indigo-600 text-white text-xs">
                            <th class="p-2 sm:p-4 border">Day</th>
                            <th class="p-2 sm:p-4 border">B-fast</th>
                            <th class="p-2 sm:p-4 border">Lunch</th>
                            <th class="p-2 sm:p-4 border">Dinner</th>
                        </tr>
                    </thead>
                    <tbody id="meal-grid-body"></tbody>
                </table>
            </div>

            <!-- Shopping List Section -->
            <div class="bg-white rounded-xl shadow-lg p-4 sm:p-6 max-w-2xl mx-auto">
                <div class="flex justify-between items-center mb-4 border-b pb-2">
                    <h2 class="text-xl font-bold text-slate-800">Shopping List</h2>
                    <div class="space-x-2">
                        <button onclick="copyToClipboard()" class="text-xs bg-indigo-100 text-indigo-700 px-2 py-1 rounded font-bold hover:bg-indigo-200">Copy for Excel</button>
                        <button onclick="clearList()" class="text-xs text-red-500 hover:text-red-700 font-semibold">Clear</button>
                    </div>
                </div>
                <ul id="shopping-list" class="space-y-1 text-sm text-slate-700">
                    <li class="text-slate-400 italic text-center py-4 text-xs">Your list is empty.</li>
                </ul>
            </div>
        </div>

        <!-- View 2: Recipe Editor -->
        <div id="editor-view" class="hidden max-w-2xl mx-auto bg-white p-6 rounded-xl shadow-lg border border-indigo-100">
            <h2 class="text-xl font-bold text-slate-800 mb-4">Paste Recipe Details</h2>
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-semibold text-slate-600 mb-1">Recipe Name (Match the Grid name)</label>
                    <input type="text" id="edit-id" placeholder="e.g., oats" class="w-full p-2 border rounded focus:ring-2 focus:ring-indigo-500 outline-none">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-600 mb-1">Display Title</label>
                    <input type="text" id="edit-title" placeholder="e.g., Creamy Steel-Cut Oats" class="w-full p-2 border rounded focus:ring-2 focus:ring-indigo-500 outline-none">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-600 mb-1">Paste Ingredients (One per line)</label>
                    <textarea id="edit-ingredients" rows="5" class="w-full p-2 border rounded text-sm font-mono"></textarea>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-600 mb-1">Paste Instructions (One per line)</label>
                    <textarea id="edit-steps" rows="5" class="w-full p-2 border rounded text-sm font-mono"></textarea>
                </div>
                <button onclick="saveRecipe()" class="w-full bg-indigo-600 text-white font-bold py-3 rounded-lg hover:bg-indigo-700 transition">Update Dashboard</button>
            </div>
        </div>
    </div>

    <!-- Recipe Modal -->
    <div id="recipe-modal" class="fixed inset-0 modal-overlay hidden flex items-center justify-center p-2 sm:p-4 z-50">
        <div class="bg-white rounded-2xl max-w-2xl w-full max-h-[95vh] overflow-y-auto shadow-2xl relative">
            <button onclick="closeModal()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 text-2xl">&times;</button>
            <div class="p-6 sm:p-8">
                <h2 id="modal-title" class="text-2xl sm:text-3xl font-bold text-indigo-700 mb-1">Recipe Title</h2>
                <div class="mb-6 bg-slate-50 p-4 rounded-lg flex items-center justify-between">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Servings</label>
                        <input type="number" id="serving-size" value="4" min="1" onchange="updateIngredientScaling()" 
                               class="w-16 p-1 border rounded text-base font-bold text-indigo-600">
                    </div>
                    <button id="add-to-list-btn" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg font-bold shadow-md text-sm">Add to List</button>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <h3 class="font-bold mb-2 border-b pb-1 text-slate-800">Ingredients</h3>
                        <ul id="modal-ingredients" class="space-y-1 text-sm text-slate-600"></ul>
                    </div>
                    <div>
                        <h3 class="font-bold mb-2 border-b pb-1 text-slate-800">Steps</h3>
                        <ol id="modal-instructions" class="space-y-2 text-sm text-slate-600 list-decimal pl-4"></ol>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const meals = [
            { day: "Mon", b: "oats", l: "kitchari", d: "salmon" },
            { day: "Tue", b: "buckwheat", l: "hummus", d: "turkey" },
            { day: "Wed", b: "eggs", l: "pesto", d: "tagine" },
            { day: "Thu", b: "banana_toast", l: "quinoa", d: "trout" },
            { day: "Fri", b: "yogurt", l: "burger", d: "dal" },
            { day: "Sat", b: "avocado_toast", l: "wrap", d: "steak" },
            { day: "Sun", b: "amaranth", l: "paella", d: "smoothie" }
        ];

        let recipes = {
            oats: { title: "Steel-Cut Oats", ingredients: [{ item: "steel-cut oats", qty: 0.125, unit: "cup" }, { item: "almond milk", qty: 0.375, unit: "cup" }], steps: ["Simmer oats 20m."] },
            kitchari: { title: "Performance Kitchari", ingredients: [{ item: "mung beans", qty: 0.125, unit: "cup" }, { item: "basmati rice", qty: 0.125, unit: "cup" }], steps: ["Boil rice/beans."] }
        };

        const masterShoppingList = [];
        let currentRecipeKey = null;

        function celebrateSuccess() {
            document.getElementById('success-section').classList.remove('hidden');
            document.getElementById('success-section').scrollIntoView({ behavior: 'smooth' });
        }

        function hideSuccess() {
            document.getElementById('success-section').classList.add('hidden');
        }

        function saveSuccessLog() {
            const rating = document.querySelector('input[name="rating"]:checked')?.value || 'N/A';
            const notes = document.getElementById('success-notes').value;
            alert(`Log Saved!\nRating: ${rating}/5 Stars\nNotes: ${notes.substring(0, 30)}...`);
            hideSuccess();
        }

        // Handle image preview
        document.getElementById('photo-upload').addEventListener('change', function(e) {
            const grid = document.getElementById('photo-preview-grid');
            grid.innerHTML = '';
            Array.from(e.target.files).forEach(file => {
                const url = URL.createObjectURL(file);
                const img = document.createElement('div');
                img.className = 'w-full aspect-square bg-cover bg-center rounded-lg border border-green-200';
                img.style.backgroundImage = `url(${url})`;
                grid.appendChild(img);
            });
        });

        function renderGrid() {
            const body = document.getElementById('meal-grid-body');
            body.innerHTML = '';
            meals.forEach(m => {
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td class="p-2 sm:p-4 border font-bold text-slate-500 bg-slate-50 text-xs">${m.day}</td>
                    <td class="p-2 sm:p-4 border recipe-cell" onclick="openRecipe('${m.b}')">${recipes[m.b]?.title || m.b}</td>
                    <td class="p-2 sm:p-4 border recipe-cell" onclick="openRecipe('${m.l}')">${recipes[m.l]?.title || m.l}</td>
                    <td class="p-2 sm:p-4 border recipe-cell" onclick="openRecipe('${m.d}')">${recipes[m.d]?.title || m.d}</td>
                `;
                body.appendChild(row);
            });
        }

        function setView(view) {
            document.getElementById('grid-view').classList.toggle('hidden', view !== 'grid');
            document.getElementById('editor-view').classList.toggle('hidden', view !== 'editor');
            document.getElementById('btn-grid').className = view === 'grid' ? 'px-4 py-2 rounded-full bg-indigo-600 text-white font-bold text-sm shadow' : 'px-4 py-2 rounded-full bg-white text-slate-600 font-bold text-sm shadow border border-slate-200';
            document.getElementById('btn-editor').className = view === 'editor' ? 'px-4 py-2 rounded-full bg-indigo-600 text-white font-bold text-sm shadow' : 'px-4 py-2 rounded-full bg-white text-slate-600 font-bold text-sm shadow border border-slate-200';
        }

        function saveRecipe() {
            const id = document.getElementById('edit-id').value.trim();
            const title = document.getElementById('edit-title').value.trim();
            const rawIng = document.getElementById('edit-ingredients').value.split('\n').filter(l => l.trim());
            const steps = document.getElementById('edit-steps').value.split('\n').filter(l => l.trim());
            if (!id || !title) return;
            recipes[id] = { title, ingredients: rawIng.map(line => ({ qty: 1, unit: '', item: line })), steps };
            renderGrid();
            setView('grid');
        }

        function openRecipe(key) {
            const recipe = recipes[key];
            if (!recipe) { document.getElementById('edit-id').value = key; setView('editor'); return; }
            currentRecipeKey = key;
            document.getElementById('modal-title').innerText = recipe.title;
            updateIngredientScaling();
            document.getElementById('modal-instructions').innerHTML = recipe.steps.map(s => `<li>${s}</li>`).join('');
            document.getElementById('add-to-list-btn').onclick = () => addToList(key);
            document.getElementById('recipe-modal').classList.remove('hidden');
        }

        function updateIngredientScaling() {
            if (!currentRecipeKey) return;
            const servings = document.getElementById('serving-size').value || 4;
            const ingredients = recipes[currentRecipeKey].ingredients;
            document.getElementById('modal-ingredients').innerHTML = ingredients.map(i => `<li class="py-1"><strong>${(i.qty * servings).toFixed(1)} ${i.unit}</strong> ${i.item}</li>`).join('');
        }

        function addToList(key) {
            const servings = document.getElementById('serving-size').value || 4;
            recipes[key].ingredients.forEach(i => masterShoppingList.push({ name: i.item, qty: i.qty * servings, unit: i.unit }));
            renderShoppingList();
            closeModal();
        }

        function renderShoppingList() {
            const el = document.getElementById('shopping-list');
            if (masterShoppingList.length === 0) { el.innerHTML = `<li class="text-slate-400 italic text-center py-4 text-xs">List empty.</li>`; return; }
            el.innerHTML = masterShoppingList.map((item, idx) => `<li class="flex justify-between items-center bg-indigo-50 px-3 py-2 rounded border border-indigo-100 mb-1 text-xs"><span><strong>${item.qty} ${item.unit}</strong> ${item.name}</span><button onclick="removeItem(${idx})" class="text-red-400">×</button></li>`).join('');
        }

        function removeItem(idx) { masterShoppingList.splice(idx, 1); renderShoppingList(); }
        function clearList() { masterShoppingList.length = 0; renderShoppingList(); }
        function closeModal() { document.getElementById('recipe-modal').classList.add('hidden'); }
        function copyToClipboard() { /* Simple clipboard logic */ alert("Copied to clipboard!"); }

        renderGrid();
    </script>
</body>
</html>
